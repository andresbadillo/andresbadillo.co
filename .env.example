# Vite: variables must be prefixed with VITE_ to be exposed to the client.
# Get the URL and publishable key in Supabase: Project Settings > Data API.
# The publishable key is safe to use in the browser; never add the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Contact form (api/contact.ts). Server-only: NO VITE_ prefix, never exposed to the browser.
# Set them in Vercel > Project > Settings > Environment Variables (Production and Preview).
# Without a verified domain, Resend only sends from onboarding@resend.dev to your own account email.
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio <contact@your-domain.com>
